model LmModel {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String   @map("tenant_id") @db.Uuid
  providerId             String   @map("provider_id") @db.Uuid
  name                   String
  modelId                String   @map("model_id")
  description            String?
  maxTokens              Int?     @map("max_tokens")
  defaultTemperature     Decimal? @map("default_temperature") @db.Decimal(2, 2)
  inputCostPer1kTokens    Decimal? @map("input_cost_per_1k_tokens") @db.Decimal(10, 8)
  outputCostPer1kTokens   Decimal? @map("output_cost_per_1k_tokens") @db.Decimal(10, 8)
  inputTokenCostUsd      Decimal? @map("input_token_cost_usd") @db.Decimal(12, 6)
  outputTokenCostUsd     Decimal? @map("output_token_cost_usd") @db.Decimal(12, 6)
  providerAccountId      String?  @map("provider_account_id") @db.Uuid
  docsUrl                String?  @map("docs_url")
  contextWindow          Int?     @map("context_window")
  displayOrder           Int?     @default(100) @map("display_order")
  tier                   String?  @default("balanced") // entry | balanced | pro | flagship
  isActive               Boolean? @default(true) @map("is_active")
  isSystem               Boolean? @default(false) @map("is_system")
  createdBy              String?  @map("created_by") @db.Uuid
  updatedBy              String?  @map("updated_by") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @default(now()) @map("updated_at")

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider        LmProvider         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerAccount LmProviderAccount?  @relation(fields: [providerAccountId], references: [id], onDelete: SetNull)

  @@unique([providerId, modelId])
  @@map("lm_models")
}
