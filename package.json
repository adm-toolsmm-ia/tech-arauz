{
  "name": "tech-arauz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css,md}\"",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "a11y:check": "next lint --max-warnings=0",
    "audit:rls": "node ./scripts/ci/check-rls-audit.mjs",
    "audit:secrets": "node ./scripts/ci/check-env-secrets.mjs",
    "sync:ide": "node .aiox-core/infrastructure/scripts/ide-sync/index.js sync",
    "sync:ide:check": "node .aiox-core/infrastructure/scripts/ide-sync/index.js validate --strict",
    "sync": "powershell -ExecutionPolicy Bypass -File ./scripts/sync.ps1",
    "sync:commit": "powershell -ExecutionPolicy Bypass -File ./scripts/git-commit.ps1",
    "sync:push": "powershell -ExecutionPolicy Bypass -File ./scripts/git-push.ps1",
    "sync:pr": "powershell -ExecutionPolicy Bypass -File ./scripts/git-pr.ps1",
    "db:apply": "npx supabase db push",
    "db:purge-logs": "node ./scripts/db/run-log-retention.mjs"
  },
  "dependencies": {
