# Vercel Environment Variables — Tech Arauz
# Template for managing production environment configuration
# Status: ✅ Active in Vercel
# Last Updated: 2026-05-15

# ============================================================================
# SUPABASE CONFIGURATION (Required)
# ============================================================================
# These are ALREADY configured in Vercel dashboard
# DO NOT commit actual values to git

NEXT_PUBLIC_SUPABASE_URL=https://pybmawlwpmxshtccpqui.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key-value>

# Notes:
# - NEXT_PUBLIC_* variables are exposed to browser (safe to be public)
# - Anon key has RLS policies that restrict data access
# - Server routes use service role key for admin operations

# ============================================================================
# AI SERVICE CONFIGURATION (Required)
# ============================================================================

NEXT_PUBLIC_AI_SERVICE_URL=https://api.openai.com/v1
# or
# NEXT_PUBLIC_AI_SERVICE_URL=https://your-ai-service.com/v1

# API Keys for AI services (server-side only)
OPENAI_API_KEY=sk-***
# or custom AI service
# AI_SERVICE_TOKEN=***

# Notes:
# - Never expose API keys to browser (not NEXT_PUBLIC_*)
# - Use in server actions: src/app/actions/*.ts
# - Rotate quarterly or if compromised

# ============================================================================
# ESPAIDER INTEGRATION (v1 + v2)
# ============================================================================

# v1 Configuration (Legacy)
ESPAIDER_API_V1_BASE_URL=https://api.espaider.com/v1
ESPAIDER_API_V1_TOKEN=***

# v2 Configuration (Current)
NEXT_PUBLIC_ESPAIDER_API_V2_BASE_URL=https://api.espaider.com/v2
ESPAIDER_API_V2_TOKEN=***

# Notes:
# - NEXT_PUBLIC_* exposed to browser (only URLs, no tokens)
# - API tokens stored as secrets in Vercel (hidden from logs)
# - Sync uses either v1 or v2 based on espaider_apis.settings.api_version
# - Token rotation: annually or if compromised

# ============================================================================
# OPTIONAL: Analytics & Monitoring
# ============================================================================

# PostHog Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=phc_***
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Sentry Error Tracking (optional)
NEXT_PUBLIC_SENTRY_DSN=https://***@***.ingest.sentry.io/***

# Notes:
# - These are optional, only needed if services are enabled
# - NEXT_PUBLIC_* safe to expose

# ============================================================================
# INTERNAL CONFIGURATION
# ============================================================================

# Node environment
NODE_ENV=production

# Next.js configuration
NEXT_TELEMETRY_DISABLED=1

# ============================================================================
# VERCEL DEPLOYMENT CONFIGURATION
# ============================================================================

# Automatically set by Vercel (do not override)
# VERCEL=1
# VERCEL_ENV=production
# VERCEL_URL=arauz-tech.vercel.app

# ============================================================================
# VALIDATION & TROUBLESHOOTING
# ============================================================================

# To verify environment variables are injected in Vercel:
# 1. Go to Vercel Dashboard → Settings → Environment Variables
# 2. Check "Production" column for each variable
# 3. Verify no red "X" marks (missing variables)

# To test locally:
# cp .env.vercel.template .env.local
# Update values with actual keys
# npm run dev

# ============================================================================
# SECURITY CHECKLIST
# ============================================================================

# ✅ DO:
# - Rotate tokens quarterly
# - Use Vercel Secrets for sensitive values
# - Review access logs monthly
# - Keep this file in git (without actual values)
# - Update LASTUPDATE when variables change

# ❌ DON'T:
# - Commit actual API keys to git
# - Share token values in Slack/email
# - Use same token across multiple environments
# - Hardcode values in code

