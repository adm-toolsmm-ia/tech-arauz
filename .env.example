# ==============================================================================
# Tech Arauz - Variáveis de Ambiente
# ==============================================================================
# Copie este arquivo para .env.local e preencha os valores
# NUNCA commite o .env.local com valores reais
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# ------------------------------------------------------------------------------
# Espaider API (ADR-002)
# ------------------------------------------------------------------------------
ESPAIDER_BASE_URL=https://espaider.com.br/Arauz/WCF/WCFExportaDados.svc
ESPAIDER_TOKEN=seu-token-aqui
ESPAIDER_KEY=sua-key-aqui

# Configurações opcionais (defaults em configs/project.yaml)
# ESPAIDER_TIMEOUT=10000
# ESPAIDER_RETRY_MAX=3
# ESPAIDER_RETRY_BASE_DELAY=1000
# ESPAIDER_RETRY_MAX_DELAY=8000
# ESPAIDER_CB_THRESHOLD=5
# ESPAIDER_CB_WINDOW=60000
# ESPAIDER_CB_RESET_TIMEOUT=30000

# ------------------------------------------------------------------------------
# LangSmith (Observabilidade AI)
# ------------------------------------------------------------------------------
LANGSMITH_API_KEY=sua-langsmith-api-key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=tech-arauz

# ------------------------------------------------------------------------------
# Sentry (Errors)
# ------------------------------------------------------------------------------
SENTRY_DSN=sua-sentry-dsn
NEXT_PUBLIC_SENTRY_DSN=sua-sentry-dsn

# ------------------------------------------------------------------------------
# App Config
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
