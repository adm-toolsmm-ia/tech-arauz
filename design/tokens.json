{
  "$schema": "https://tokens.studio/schemas/draft/2023-07-20/tokens-schema.json",
  "$version": "1.0.0",
  "metadata": {
    "tokenSetOrder": [
      "global",
      "light",
      "dark"
    ],
    "description": "Design tokens extracted from Tech Arauz design system (DTCG format)"
  },
  "global": {
    "colors": {
      "semantic": {
        "background": {
          "$type": "color",
          "$value": "hsl(0 0% 100%)",
          "$description": "Primary background color"
        },
        "foreground": {
          "$type": "color",
          "$value": "hsl(0 0% 3.6%)",
          "$description": "Primary text color"
        },
        "card": {
          "$type": "color",
          "$value": "hsl(0 0% 100%)",
          "$description": "Card background"
        },
        "card-foreground": {
          "$type": "color",
          "$value": "hsl(0 0% 3.6%)",
          "$description": "Card text color"
        },
        "popover": {
          "$type": "color",
          "$value": "hsl(0 0% 100%)",
          "$description": "Popover background"
        },
        "popover-foreground": {
          "$type": "color",
          "$value": "hsl(0 0% 3.6%)",
          "$description": "Popover text"
        }
      },
      "primary": {
        "default": {
          "$type": "color",
          "$value": "hsl(222.2 47.4% 11.2%)",
          "$description": "Primary brand color"
        },
        "foreground": {
          "$type": "color",
          "$value": "hsl(210 40% 98%)",
          "$description": "Text on primary color"
        }
      },
      "secondary": {
        "default": {
          "$type": "color",
          "$value": "hsl(217.2 32.6% 17.5%)",
          "$description": "Secondary color"
        },
        "foreground": {
          "$type": "color",
          "$value": "hsl(210 40% 98%)",
          "$description": "Text on secondary"
        }
      },
      "muted": {
        "default": {
          "$type": "color",
          "$value": "hsl(210 40% 96.1%)",
          "$description": "Muted/disabled state"
        },
        "foreground": {
          "$type": "color",
          "$value": "hsl(215.4 16.3% 46.9%)",
          "$description": "Text on muted"
        }
      },
      "accent": {
        "default": {
          "$type": "color",
          "$value": "hsl(262.1 80% 50.4%)",
          "$description": "Accent color"
        },
        "foreground": {
          "$type": "color",
          "$value": "hsl(210 40% 98%)",
          "$description": "Text on accent"
        }
      },
      "destructive": {
        "default": {
          "$type": "color",
          "$value": "hsl(0 84.2% 60.2%)",
          "$description": "Error/danger color"
        },
        "foreground": {
          "$type": "color",
          "$value": "hsl(210 40% 98%)",
          "$description": "Text on destructive"
        }
      },
      "success": {
        "default": {
          "$type": "color",
          "$value": "hsl(142.3 71.8% 29.2%)",
          "$description": "Success color"
        },
        "foreground": {
          "$type": "color",
          "$value": "hsl(210 40% 98%)",
          "$description": "Text on success"
        }
      },
      "warning": {
        "default": {
          "$type": "color",
          "$value": "hsl(38.6 92.1% 50.2%)",
          "$description": "Warning color"
        },
        "foreground": {
          "$type": "color",
          "$value": "hsl(48 96% 53%)",
          "$description": "Text on warning"
        }
      },
      "border": {
        "$type": "color",
        "$value": "hsl(214.3 31.8% 91.4%)",
        "$description": "Border color"
      },
      "input": {
        "$type": "color",
        "$value": "hsl(214.3 31.8% 91.4%)",
        "$description": "Input field border"
      },
      "ring": {
        "$type": "color",
        "$value": "hsl(222.2 47.4% 11.2%)",
        "$description": "Focus ring color"
      }
    },
    "sidebar": {
      "background": {
        "$type": "color",
        "$value": "hsl(0 0% 96.5%)",
        "$description": "Sidebar background"
      },
      "foreground": {
        "$type": "color",
        "$value": "hsl(222.2 47.4% 11.2%)",
        "$description": "Sidebar text"
      },
      "primary": {
        "$type": "color",
        "$value": "hsl(222.2 47.4% 11.2%)",
        "$description": "Sidebar primary action"
      },
      "primary-foreground": {
        "$type": "color",
        "$value": "hsl(210 40% 98%)",
        "$description": "Text on sidebar primary"
      },
      "accent": {
        "$type": "color",
        "$value": "hsl(262.1 80% 50.4%)",
        "$description": "Sidebar accent"
      },
      "accent-foreground": {
        "$type": "color",
        "$value": "hsl(210 40% 98%)",
        "$description": "Text on sidebar accent"
      },
      "border": {
        "$type": "color",
        "$value": "hsl(214.3 31.8% 91.4%)",
        "$description": "Sidebar border"
      },
      "ring": {
        "$type": "color",
        "$value": "hsl(222.2 47.4% 11.2%)",
        "$description": "Sidebar focus ring"
      }
    },
    "status": {
      "novo": {
        "$type": "color",
        "$value": "hsl(262.1 80% 50.4%)",
        "$description": "New status (purple)"
      },
      "em-atendimento": {
        "$type": "color",
        "$value": "hsl(38.6 92.1% 50.2%)",
        "$description": "In progress status (orange)"
      },
      "aguardando": {
        "$type": "color",
        "$value": "hsl(25 95% 53%)",
        "$description": "Awaiting status (coral)"
      },
      "resolvido": {
        "$type": "color",
        "$value": "hsl(142.3 71.8% 29.2%)",
        "$description": "Resolved status (green)"
      },
      "cancelado": {
        "$type": "color",
        "$value": "hsl(0 84.2% 60.2%)",
        "$description": "Cancelled status (red)"
      }
    },
    "priority": {
      "alta": {
        "$type": "color",
        "$value": "hsl(0 84.2% 60.2%)",
        "$description": "High priority (red)"
      },
      "normal": {
        "$type": "color",
        "$value": "hsl(38.6 92.1% 50.2%)",
        "$description": "Normal priority (orange)"
      },
      "baixa": {
        "$type": "color",
        "$value": "hsl(142.3 71.8% 29.2%)",
        "$description": "Low priority (green)"
      }
    },
    "type": {
      "erro": {
        "$type": "color",
        "$value": "hsl(0 84.2% 60.2%)",
        "$description": "Error type (red)"
      },
      "duvida": {
        "$type": "color",
        "$value": "hsl(38.6 92.1% 50.2%)",
        "$description": "Question type (orange)"
      },
      "suporte": {
        "$type": "color",
        "$value": "hsl(262.1 80% 50.4%)",
        "$description": "Support type (purple)"
      },
      "ajuste": {
        "$type": "color",
        "$value": "hsl(215.4 16.3% 46.9%)",
        "$description": "Adjustment type (gray)"
      },
      "melhoria": {
        "$type": "color",
        "$value": "hsl(142.3 71.8% 29.2%)",
        "$description": "Improvement type (green)"
      }
    },
    "chart": {
      "1": {
        "$type": "color",
        "$value": "hsl(12 76% 61%)",
        "$description": "Chart color 1 (orange)"
      },
      "2": {
        "$type": "color",
        "$value": "hsl(173 58% 39%)",
        "$description": "Chart color 2 (teal)"
      },
      "3": {
        "$type": "color",
        "$value": "hsl(197 89% 48%)",
        "$description": "Chart color 3 (blue)"
      },
      "4": {
        "$type": "color",
        "$value": "hsl(283 65% 49%)",
        "$description": "Chart color 4 (purple)"
      },
      "5": {
        "$type": "color",
        "$value": "hsl(25 95% 53%)",
        "$description": "Chart color 5 (coral)"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": {
        "$type": "fontFamily",
        "$value": ["Inter", "system-ui", "sans-serif"],
        "$description": "Primary sans-serif font"
      },
      "display": {
        "$type": "fontFamily",
        "$value": ["DM Sans", "Inter", "system-ui", "sans-serif"],
        "$description": "Display font for headings"
      }
    }
  },
  "effects": {
    "borderRadius": {
      "lg": {
        "$type": "dimension",
        "$value": "0.5rem",
        "$description": "Large border radius"
      },
      "md": {
        "$type": "dimension",
        "$value": "calc(0.5rem - 2px)",
        "$description": "Medium border radius"
      },
      "sm": {
        "$type": "dimension",
        "$value": "calc(0.5rem - 4px)",
        "$description": "Small border radius"
      }
    },
    "shadows": {
      "soft": {
        "$type": "shadow",
        "$value": {
          "x": "0",
          "y": "2px",
          "blur": "8px",
          "spread": "0",
          "color": "rgba(0, 0, 0, 0.06)"
        },
        "$description": "Soft shadow (subtle)"
      },
      "medium": {
        "$type": "shadow",
        "$value": {
          "x": "0",
          "y": "4px",
          "blur": "16px",
          "spread": "0",
          "color": "rgba(0, 0, 0, 0.08)"
        },
        "$description": "Medium shadow"
      },
      "card": {
        "$type": "shadow",
        "$value": [
          {
            "x": "0",
            "y": "1px",
            "blur": "3px",
            "spread": "0",
            "color": "rgba(0, 0, 0, 0.08)"
          },
          {
            "x": "0",
            "y": "1px",
            "blur": "2px",
            "spread": "0",
            "color": "rgba(0, 0, 0, 0.04)"
          }
        ],
        "$description": "Card shadow (layered)"
      },
      "card-hover": {
        "$type": "shadow",
        "$value": {
          "x": "0",
          "y": "8px",
          "blur": "30px",
          "spread": "0",
          "color": "rgba(0, 0, 0, 0.12)"
        },
        "$description": "Card hover shadow (elevated)"
      },
      "elevated": {
        "$type": "shadow",
        "$value": {
          "x": "0",
          "y": "12px",
          "blur": "40px",
          "spread": "0",
          "color": "rgba(0, 0, 0, 0.12)"
        },
        "$description": "Elevated shadow (modal)"
      },
      "inner-glow": {
        "$type": "shadow",
        "$value": {
          "x": "0",
          "y": "1px",
          "blur": "0",
          "spread": "0",
          "color": "rgba(255, 255, 255, 0.1)",
          "inset": true
        },
        "$description": "Inner glow (inset white)"
      }
    },
    "animations": {
      "accordion-down": {
        "$type": "animation",
        "$value": {
          "duration": "0.2s",
          "timingFunction": "ease-out"
        },
        "$description": "Accordion expand animation"
      },
      "accordion-up": {
        "$type": "animation",
        "$value": {
          "duration": "0.2s",
          "timingFunction": "ease-out"
        },
        "$description": "Accordion collapse animation"
      },
      "scale-in": {
        "$type": "animation",
        "$value": {
          "duration": "0.2s",
          "timingFunction": "ease-out"
        },
        "$description": "Scale in animation"
      },
      "slide-in-left": {
        "$type": "animation",
        "$value": {
          "duration": "0.2s",
          "timingFunction": "ease-out"
        },
        "$description": "Slide in from left"
      }
    }
  }
}
