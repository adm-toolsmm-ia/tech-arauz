{
  "$schema": "https://tokens.studio/schema/draft.json",
  "$metadata": {
    "name": "Tech Arauz Design Tokens",
    "version": "1.1.0",
    "description": "W3C Design Token Community Group (DTCG) format - Complete system",
    "tokenSetOrder": ["colors", "typography", "spacing", "borders", "shadows"]
  },
  "colors": {
    "primary": {
      "50": {"$value": "#f0f7ff", "$type": "color"},
      "100": {"$value": "#e0effe", "$type": "color"},
      "200": {"$value": "#bae0ff", "$type": "color"},
      "300": {"$value": "#91caff", "$type": "color"},
      "400": {"$value": "#69b1ff", "$type": "color"},
      "500": {"$value": "#4096ff", "$type": "color"},
      "600": {"$value": "#1677ff", "$type": "color"},
      "700": {"$value": "#0958d9", "$type": "color"},
      "800": {"$value": "#003eb3", "$type": "color"},
      "900": {"$value": "#002882", "$type": "color"}
    },
    "secondary": {
      "50": {"$value": "#f6f8fb", "$type": "color"},
      "100": {"$value": "#e6eef7", "$type": "color"},
      "500": {"$value": "#629abb", "$type": "color"},
      "900": {"$value": "#093153", "$type": "color"}
    },
    "semantic": {
      "success": {"$value": "#52c41a", "$type": "color"},
      "success-light": {"$value": "#f6ffed", "$type": "color"},
      "warning": {"$value": "#faad14", "$type": "color"},
      "warning-light": {"$value": "#fffbe6", "$type": "color"},
      "error": {"$value": "#f5222d", "$type": "color"},
      "error-light": {"$value": "#fff1f0", "$type": "color"},
      "info": {"$value": "#1890ff", "$type": "color"},
      "info-light": {"$value": "#e6f7ff", "$type": "color"}
    },
    "grayscale": {
      "50": {"$value": "#fafafa", "$type": "color"},
      "100": {"$value": "#f5f5f5", "$type": "color"},
      "200": {"$value": "#eeeeee", "$type": "color"},
      "300": {"$value": "#e8e8e8", "$type": "color"},
      "400": {"$value": "#d9d9d9", "$type": "color"},
      "500": {"$value": "#bfbfbf", "$type": "color"},
      "600": {"$value": "#8c8c8c", "$type": "color"},
      "700": {"$value": "#595959", "$type": "color"},
      "800": {"$value": "#262626", "$type": "color"},
      "900": {"$value": "#000000", "$type": "color"}
    }
  },
  "typography": {
    "fontFamily": {
      "body": {"$value": "'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif", "$type": "fontFamily"},
      "heading": {"$value": "'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif", "$type": "fontFamily"},
      "mono": {"$value": "'Fira Code', 'Courier New', monospace", "$type": "fontFamily"}
    },
    "fontSize": {
      "xs": {"$value": "12px", "$type": "dimension"},
      "sm": {"$value": "14px", "$type": "dimension"},
      "base": {"$value": "16px", "$type": "dimension"},
      "lg": {"$value": "18px", "$type": "dimension"},
      "xl": {"$value": "20px", "$type": "dimension"},
      "2xl": {"$value": "24px", "$type": "dimension"},
      "3xl": {"$value": "30px", "$type": "dimension"}
    },
    "fontWeight": {
      "regular": {"$value": "400", "$type": "fontWeight"},
      "medium": {"$value": "500", "$type": "fontWeight"},
      "semibold": {"$value": "600", "$type": "fontWeight"},
      "bold": {"$value": "700", "$type": "fontWeight"}
    },
    "lineHeight": {
      "tight": {"$value": "1.2", "$type": "dimension"},
      "normal": {"$value": "1.5", "$type": "dimension"},
      "relaxed": {"$value": "1.75", "$type": "dimension"}
    }
  },
  "spacing": {
    "xs": {"$value": "4px", "$type": "dimension"},
    "sm": {"$value": "8px", "$type": "dimension"},
    "md": {"$value": "12px", "$type": "dimension"},
    "base": {"$value": "16px", "$type": "dimension"},
    "lg": {"$value": "24px", "$type": "dimension"},
    "xl": {"$value": "32px", "$type": "dimension"},
    "2xl": {"$value": "40px", "$type": "dimension"},
    "3xl": {"$value": "48px", "$type": "dimension"}
  },
  "borders": {
    "radius": {
      "none": {"$value": "0px", "$type": "dimension"},
      "sm": {"$value": "4px", "$type": "dimension"},
      "base": {"$value": "6px", "$type": "dimension"},
      "md": {"$value": "8px", "$type": "dimension"},
      "lg": {"$value": "12px", "$type": "dimension"},
      "full": {"$value": "9999px", "$type": "dimension"}
    },
    "width": {
      "thin": {"$value": "1px", "$type": "dimension"},
      "base": {"$value": "2px", "$type": "dimension"},
      "thick": {"$value": "3px", "$type": "dimension"}
    }
  },
  "shadows": {
    "sm": {"$value": "0 1px 2px 0 rgba(0, 0, 0, 0.05)", "$type": "shadow"},
    "base": {"$value": "0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06)", "$type": "shadow"},
    "md": {"$value": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)", "$type": "shadow"},
    "lg": {"$value": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)", "$type": "shadow"},
    "xl": {"$value": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04)", "$type": "shadow"}
  }
}
