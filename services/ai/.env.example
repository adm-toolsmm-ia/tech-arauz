# ==============================================================================
# Tech Arauz AI Service - Variáveis de Ambiente
# ==============================================================================

# ------------------------------------------------------------------------------
# LangSmith (Observability)
# ------------------------------------------------------------------------------
# NOTA: O SDK do LangSmith le internamente LANGCHAIN_API_KEY.
# Voce pode usar LANGSMITH_API_KEY (o sistema mapeia automaticamente via
# init_tracer()). Nunca coloque a key no codigo — apenas aqui no .env.
LANGSMITH_API_KEY=your-langsmith-api-key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=tech-arauz

# ------------------------------------------------------------------------------
# LLM Provider (OpenAI ou outro)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sua-openai-api-key
# ANTHROPIC_API_KEY=sua-anthropic-api-key

# ------------------------------------------------------------------------------
# Supabase (para persistência de estado)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_KEY=sua-service-role-key

# ------------------------------------------------------------------------------
# Next.js API (para callbacks)
# ------------------------------------------------------------------------------
NEXTJS_API_URL=http://localhost:3000/api

# ------------------------------------------------------------------------------
# App Config
# ------------------------------------------------------------------------------
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Observability — Feature Flags
# See docs/observability.md for details.
# ------------------------------------------------------------------------------

# Master switch — set to false to disable all instrumentation
OBS_ENABLED=true

# Backend: langsmith | local
OBS_BACKEND=langsmith

# Redact PII (emails, phones, CPFs, API keys) in logs and spans
OBS_PII_REDACT=true

# Log level for observability logger (DEBUG, INFO, WARNING, ERROR)
OBS_LOG_LEVEL=INFO

# Budget limits (USD) — set to 0 for unlimited
OBS_BUDGET_SESSION_USD=0.50
OBS_BUDGET_USER_USD=5.00
OBS_BUDGET_AGENT_USD=2.00
